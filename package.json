{
  "name": "fortunes-weave-planner",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "desktop": "ng build && electron .",
    "dist:win": "ng build && electron-builder --win",
    "dist:mac": "ng build && electron-builder --mac",
    "dist:linux": "ng build && electron-builder --linux"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "Unit planner for Fire Emblem: Fortune's Weave",
  "author": "CoryKleinjan",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.corykleinjan.fortunesweaveplanner",
    "productName": "Fortunes Weave Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/fortunes-weave-planner/browser/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FortunesWeavePlanner-Setup.exe"
    },
    "portable": {
      "artifactName": "FortunesWeavePlanner-Portable.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
